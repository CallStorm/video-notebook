# .env.example
# 复制为 .env 后，api 用（uvicorn + alembic 直接读）。middlewares 用 compose.middleware.yml 起。

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ── Database ── dev：连 compose.middleware 起的 127.0.0.1:3306 ────────────
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_USER=vnb
MYSQL_PASSWORD=changeme-vnb
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=video_notebook

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod-use-openssl-rand-base64-32
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# ── AES 主密钥（DB 内 api_key_enc 用的解密主密钥） ──────────────────────
MASTER_SECRET=change-me-master-32-bytes-base64

# ── LLM 默认（minimax，Anthropic-兼容 SDK） ───────────────────────────────
LLM_PROVIDER=minimax
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# ── 知识底稿生成（completion max_tokens）───────────────────────────────
# 环境变量默认值；管理后台「底稿策略 → 全局设置」可覆盖并持久化到 DB
# 主调用与 JSON 修复共用；模型有上限时 API 会自行截断或拒绝
DRAFT_MAX_TOKENS=200000

# ── ASR 默认 ────────────────────────────────────────────────────────────
ASR_PROVIDER=whisper
ASR_API_KEY=
ASR_MODEL_SIZE=large-v3
ASR_LANGUAGE_POLICY=auto

# ── 本地存储（开发期写仓库目录；容器部署再改成 /data/...） ───────────────
STORAGE_ROOT=./storage
SKILLS_ROOT=./skills

# Claude Code 的 Key、Base URL 和模型名在后台首页配置，不从这里读。

# ── 首个管理员 seed（容器首次启动时检测无 admin 则创建） ─────────────────
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=changeme-on-first-login

# Cookie / 代理：后台「抓取与网络」配置（不再使用 YTDLP_COOKIES_*）

# ── Qdrant（语义检索向量库；后台「向量配置」可改地址）────────────────
# make middleware 会起 vnb-qdrant；或: docker run -p 6333:6333 qdrant/qdrant
# QDRANT_URL=http://127.0.0.1:6333


# ── Docker Compose（一键部署）────────────────────────────────────────
# 根目录 docker compose up 时，compose 会强制覆盖：
#   MYSQL_HOST=mysql
#   REDIS_URL=redis://redis:6379/0
#   CELERY_BROKER_URL=redis://redis:6379/1
#   CELERY_RESULT_BACKEND=redis://redis:6379/2
#   STORAGE_ROOT=/data/video-notebook
#   SKILLS_ROOT=/data/skills
# 详见 .env.docker.example 与 docs/deployment.md。
# 全栈 Compose 内后台「向量配置」请用 http://qdrant:6333
