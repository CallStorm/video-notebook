# .env.docker.example
# Docker Compose 一键部署时的参考覆盖项。
# 用法：先 cp .env.example .env，再按需把下面几行合并进 .env。
# docker-compose.yml 会用 environment: 强制覆盖主机名为容器网络名，
# 因此即使 .env 里仍是 127.0.0.1，Compose 内也会连上 mysql/redis。

# ── 与本地开发相同，务必改掉默认密钥 ───────────────────────────────
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_USER=vnb
MYSQL_PASSWORD=changeme-vnb
MYSQL_DATABASE=video_notebook
JWT_SECRET=change-me-in-prod-use-openssl-rand-base64-32
MASTER_SECRET=change-me-master-32-bytes-base64
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=changeme-on-first-login

# ── Compose 内由 docker-compose.yml 覆盖（写在这里仅作说明）────────
# MYSQL_HOST=mysql
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# STORAGE_ROOT=/data/video-notebook
# SKILLS_ROOT=/data/skills

# ── 向量库 ──────────────────────────────────────────────────────────
# Qdrant 地址存在后台「向量配置」，默认常为 http://127.0.0.1:6333。
# 全栈 Compose 内请改为：http://qdrant:6333
# （容器互访用服务名；本机浏览器仍可用 http://127.0.0.1:6333 看 Qdrant）

APP_ENV=prod
DEBUG=false
